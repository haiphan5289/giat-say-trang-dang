# Figma MCP Proxy - Environment Variables
# Copy this file to .env and fill in your token
# NEVER commit .env to git — it's already in .gitignore

# Get your token from: https://www.figma.com/settings → "Personal access tokens"
# Required scope : File content (read)  ← mandatory
# Optional scope : Variables (read)     ← only if on Professional/Org plan; needed for get_variable_defs
FIGMA_TOKEN=your_figma_personal_access_token_here

# Optional: Cache TTL in milliseconds (default: 300000 = 5 minutes)
# CACHE_TTL_MS=300000
